[Unit]
Description=cua service
ConditionPathExists=/kvmapp/cua/cua_webapp.py
After=network.target

[Service]
Type=simple
ExecReload=/bin/kill -HUP $MAINPID
User=root
Group=root
LimitNOFILE=100000

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

WorkingDirectory=/kvmapp/cua
# --auth, as the server passes when the web UI starts the assistant: without
# it every endpoint (screen capture, mouse, keyboard) is open to the network.
# The app keeps listening on 0.0.0.0:5000 because the web UI opens
# http://<device>:5000/ directly in the browser; localhost would break it.
ExecStart=/kvmapp/cua/cua_webapp.py --auth

PermissionsStartOnly=true
ExecStartPre=/bin/chown -R root:root /kvmapp/cua
ExecStartPre=/bin/chmod 755 /kvmapp/cua/cua_webapp.py

[Install]
WantedBy=multi-user.target
