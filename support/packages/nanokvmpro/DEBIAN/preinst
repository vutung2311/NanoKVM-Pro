#!/bin/bash
set -e

version_lt() {
    [ "$1" = "$2" ] && return 1
    local IFS=.
    local i ver1=($1) ver2=($2)
    for ((i=${#ver1[@]}; i<${#ver2[@]}; i++)); do
        ver1[i]=0
    done
    for ((i=0; i<${#ver2[@]}; i++)); do
        if ((10#${ver1[i]} < 10#${ver2[i]})); then
            return 0
        elif ((10#${ver1[i]} > 10#${ver2[i]})); then
            return 1
        fi
    done
    return 1
}

# Up to 1.x the TLS key/cert and device_number were package files, shared by
# every device. They are no longer shipped, so dpkg deletes them while
# unpacking this version. Keep a copy; postinst puts back the ones that are
# the device's own and drops the shared ones.
PRESERVE_DIR=/var/lib/nanokvmpro/preserve
case "$1" in
    install|upgrade)
        mkdir -p "$PRESERVE_DIR"
        chmod 700 "$PRESERVE_DIR"
        for f in /etc/kvm/server.key /etc/kvm/server.crt /etc/kvm/device_number /kvmapp/device_number; do
            if [ -f "$f" ]; then
                cp -p "$f" "$PRESERVE_DIR/${f//\//_}"
            fi
        done
        ;;
esac

systemctl disable nginx 2>/dev/null || true

if [ "$(stat -c %d:%i /)" == "$(stat -c %d:%i /proc/1/root/.)" ]; then
    systemctl stop nginx 2>/dev/null || true
fi

if [ -f /kvmapp/version ] && command -v tailscaled >/dev/null 2>&1; then
    read -r current_version < /kvmapp/version

    if version_lt "$current_version" "1.1.7" && \
       systemctl is-active --quiet tailscaled && \
       ! systemctl is-enabled --quiet tailscaled; then
        systemctl enable tailscaled >/dev/null 2>&1 || true
    fi
fi
