[Unit]
Description=KVM Commom Server
# Board init loads the ax_* media drivers kvm_vin needs and the touch driver
# kvm_ui reads. Without this ordering kvm_vin could start first, die, and
# restart the whole unit.
Wants=kvm-board-init.service
After=kvm-board-init.service

[Service]
Type=simple
ExecStartPre=/kvmcomm/scripts/kvmcomm_pre.sh
ExecStart=/dev/shm/kvmcomm/scripts/kvmcomm.sh
ExecStop=/bin/kill -s TERM $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=10
User=root
Group=root
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal
KillMode=control-group

[Install]
WantedBy=multi-user.target
