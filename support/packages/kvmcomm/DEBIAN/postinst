#!/bin/bash
set -e
ldconfig

readonly USERAPP_DEMO_PATH=/kvmcomm/ui/userapp_demo.tar
readonly USERAPP_TMP_PATH=/tmp/userapp
readonly USERAPP_TARGET_DIR=/userapp
readonly OVERLAY_TARGET_DIR=/kvmcomm/overlay
readonly WIFI_CONF="/etc/kvm/wifi.conf"

mkdir -p "$USERAPP_TMP_PATH"
tar -xf "$USERAPP_DEMO_PATH" -C "$USERAPP_TMP_PATH"

if [ ! -d "$USERAPP_TARGET_DIR" ]; then
    echo "$USERAPP_TARGET_DIR not found, extracting from $USERAPP_DEMO_PATH..."
    mkdir -p "$USERAPP_TARGET_DIR"
    mv "$USERAPP_TMP_PATH"/* "$USERAPP_TARGET_DIR"/

    for dir in "$USERAPP_TARGET_DIR"/*/; do
        if [ -d "$dir" ] && [ -e "$dir/new" ]; then
            rm -rf "$dir/new"
        fi
    done
else
    echo "$USERAPP_TARGET_DIR exists, skip template extraction."
    echo "If you want to overwrite it manually, run:"
    echo "  sudo tar -xf $USERAPP_DEMO_PATH -C $USERAPP_TARGET_DIR"

    if [ -d "$USERAPP_TMP_PATH" ]; then
        for dir in "$USERAPP_TMP_PATH"/*/; do
            if [ -d "$dir" ]; then
                if [ -e "$dir/new" ]; then
                    dirname=$(basename "$dir")
                    rm -rf "$USERAPP_TARGET_DIR/$dirname"
                    cp -r "$dir" "$USERAPP_TARGET_DIR/$dirname"
                    rm -rf "$USERAPP_TARGET_DIR/$dirname/new"
                fi
            fi
        done
    fi
fi

rm -rf "$USERAPP_TMP_PATH" || true

# ifplugd runs every script in /etc/ifplugd/action.d. Its own "ifupdown"
# script calls ifup/ifdown, which would start a second DHCP client next to
# ours (action.d/kvmcomm), so divert it out of action.d. The diverted copy is
# kept byte-identical to ifplugd's packaged file: dpkg then upgrades it
# silently (no conffile prompt), and outside action.d it never runs.
#
# Older kvmcomm versions overwrote action.d/ifupdown with our script. Where
# dpkg kept that copy it saved the packaged one as ifupdown.dpkg-dist, so put
# the packaged file back before diverting it.
readonly IFPLUGD_STOCK_ACTION=/etc/ifplugd/action.d/ifupdown
readonly IFPLUGD_STOCK_DIVERTED=/etc/ifplugd/ifupdown.action.kvmcomm-diverted
if [ "$(dpkg-divert --listpackage "$IFPLUGD_STOCK_ACTION" 2>/dev/null)" != "kvmcomm" ]; then
    mkdir -p "$(dirname "$IFPLUGD_STOCK_ACTION")"
    if [ -f "$IFPLUGD_STOCK_ACTION.dpkg-dist" ]; then
        mv -f "$IFPLUGD_STOCK_ACTION.dpkg-dist" "$IFPLUGD_STOCK_ACTION"
    fi
    rm -f "$IFPLUGD_STOCK_DIVERTED" # leftover from a removed diversion; --rename must not overwrite
    dpkg-divert --package kvmcomm --rename --divert "$IFPLUGD_STOCK_DIVERTED" --add "$IFPLUGD_STOCK_ACTION"
fi
# run-parts skips names containing a dot, but keep action.d to our script only.
rm -f "$IFPLUGD_STOCK_ACTION.dpkg-dist" "$IFPLUGD_STOCK_ACTION.dpkg-old" "$IFPLUGD_STOCK_ACTION.dpkg-new"

if [ -d "$OVERLAY_TARGET_DIR" ]; then
    echo "Copying overlay files from $OVERLAY_TARGET_DIR to / ..."
    rsync -a --no-owner --no-group "$OVERLAY_TARGET_DIR"/ /
else
    echo "Overlay directory $OVERLAY_TARGET_DIR not found, skipping."
fi

check_and_fix_owner() {
    local dir="$1"
    if [ -d "$dir" ]; then
        find "$dir" \( -uid 1000 -o -gid 1000 \) -exec chown root:root {} +
    fi
}

for d in /kvmapp /kvmcomm /opt /res /root /soc /userapp /etc; do
    check_and_fix_owner "$d" || true
done

# fix chrony owner
chown _chrony:_chrony /var/lib/chrony >/dev/null 2>&1 || true

mkdir -p /sdcard

# Wi-Fi is (re)connected only by kvmcomm.sh's `wifi.sh try_connect`, which
# also migrates a legacy $WIFI_CONF passphrase. A second trigger here raced it
# and dropped a working link.

if [ -f /boot/configs ]; then
    sed -i 's/\(maix_memory_cmm=\).*/\1200/' /boot/configs || true
fi

if [ -f /etc/systemd/journald.conf ]; then
    sed -i -E \
        -e '/^#?SystemMaxUse=/c SystemMaxUse=200M' \
        -e '/^#?SystemMaxFileSize=/c SystemMaxFileSize=50M' \
        /etc/systemd/journald.conf
    grep -q '^SystemMaxUse=' /etc/systemd/journald.conf || echo 'SystemMaxUse=200M' >> /etc/systemd/journald.conf
    grep -q '^SystemMaxFileSize=' /etc/systemd/journald.conf || echo 'SystemMaxFileSize=50M' >> /etc/systemd/journald.conf
fi

if [ -f /etc/crontab ]; then
    sed -i '/\/sbin\/hwclock -w -f \/dev\/rtc0/d' /etc/crontab || true
    sed -i '/sleep 60 && systemctl restart ntp/d' /etc/crontab || true
fi

if [ -f /etc/rc.local ]; then
    sed -i 's|^bash/etc/init.d/axemac.sh$|bash /etc/init.d/axemac.sh|' /etc/rc.local
    sed -i '/192\.168\.100\.200/d' /etc/rc.local
fi

# Delegate eth0 dynamically to ifplugd on physical cable carrier, preventing boot dhclient loops.
# Only strip ifupdown's hotplug stanza when ifplugd is really there to take eth0 over;
# otherwise Ethernet would never come up.
if [ -f /etc/network/interfaces ] && [ -x /usr/sbin/ifplugd ]; then
    sed -i '/allow-hotplug eth0/d' /etc/network/interfaces
fi
if ip link show eth0 2>/dev/null | grep -q "NO-CARRIER"; then
    pkill -f "dhclient.*eth0" 2>/dev/null || true
fi

ldconfig

mkdir -p /etc/systemd/system/multi-user.target.wants
[ -f /etc/systemd/system/kvmcomm.service ] && ln -sf /etc/systemd/system/kvmcomm.service /etc/systemd/system/multi-user.target.wants/kvmcomm.service

# Disable and mask systemd wpa_supplicant to avoid EAPOL / GTK rekey races with wifi.sh
rm -f /etc/systemd/system/multi-user.target.wants/wpa_supplicant.service /etc/systemd/system/dbus-fi.w1.wpa_supplicant1.service
ln -sf /dev/null /etc/systemd/system/wpa_supplicant.service
ln -sf /dev/null /etc/systemd/system/dbus-fi.w1.wpa_supplicant1.service

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    if [ "$(stat -c %d:%i /)" == "$(stat -c %d:%i /proc/1/root/.)" ]; then
        systemctl stop wpa_supplicant.service 2>/dev/null || true
        # Pick up /etc/ssh/sshd_config.d/10-nanokvm.conf (root password login) without
        # dropping existing sessions; never reload into a config sshd rejects.
        if [ -x /usr/sbin/sshd ] && /usr/sbin/sshd -t 2>/dev/null; then
            systemctl try-reload-or-restart ssh.service 2>/dev/null || true
        fi
        if [ ! -d /root/factory_test ]; then
            systemctl start kvmcomm.service
        fi
    fi
fi
